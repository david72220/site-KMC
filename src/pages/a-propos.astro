---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'À propos – KMC';
const pageDescription = 'Découvrez KMC, le Knowledge Management Center, centre de formation aux métiers de la fibre optique à Abidjan, Côte d\'Ivoire.';
---

<Layout title={pageTitle} description={pageDescription}>
  <Navigation />

  <main class="bg-[#0B1120] min-h-screen">
    {/* Hero */}
    <section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8">
      <div class="absolute inset-0 bg-gradient-to-b from-[#3b97d3]/5 to-transparent pointer-events-none" />
      <div class="max-w-4xl mx-auto text-center relative">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3b97d3]/10 border border-[#3b97d3]/20 text-[#3b97d3] text-sm font-medium mb-6">
          Notre histoire
        </span>
        <h1 class="text-4xl sm:text-5xl font-display font-bold text-white mb-6 leading-tight">
          À propos de <span class="text-[#3b97d3]">KMC</span>
        </h1>
        <p class="text-lg text-white/60 max-w-2xl mx-auto leading-relaxed">
          Knowledge Management Center est un centre de formation spécialisé dans les métiers de la fibre optique, basé à Abidjan, Côte d'Ivoire.
        </p>
      </div>
    </section>

    {/* Mission */}
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl font-display font-bold text-white mb-4">Notre mission</h2>
            <p class="text-white/60 leading-relaxed mb-4">
              Former les professionnels de demain aux métiers techniques de pointe en Côte d'Ivoire. Nous proposons des formations certifiantes, pratiques et adaptées aux besoins du marché ivoirien.
            </p>
            <p class="text-white/60 leading-relaxed">
              Nos programmes couvrent l'installation et la maintenance des réseaux à fibre optique (NRO, SRO, PBO, raccordement client) ainsi que les habilitations électriques associées.
            </p>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#3b97d3]/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#3b97d3]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Formations certifiantes</h3>
                <p class="text-white/50 text-sm">Diplômes et attestations reconnus par les opérateurs télécoms</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#3b97d3]/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#3b97d3]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Pratique terrain</h3>
                <p class="text-white/50 text-sm">80 % de pratique sur matériel professionnel réel</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#3b97d3]/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#3b97d3]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Formateurs experts</h3>
                <p class="text-white/50 text-sm">Intervenants issus du terrain avec plus de 10 ans d'expérience</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl font-display font-bold text-white mb-4">Prêt à vous former ?</h2>
        <p class="text-white/60 mb-8">Découvrez nos formations ou contactez-nous pour un devis personnalisé.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/formations-fibre-optique/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#3b97d3] text-[#0B1120] font-semibold text-sm hover:bg-[#3b97d3]/90 transition-colors">
            Voir les formations
          </a>
          <a href="/contact/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white/[0.06] border border-white/[0.1] text-white font-semibold text-sm hover:bg-white/[0.1] transition-colors">
            Nous contacter
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ScrollytellingHero from '../components/ScrollytellingHero.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'KMC.ci — Centre de Formation en Fibre Optique';
const pageDescription = 'KMC, le premier centre de formation en fibre optique en Côte d\'Ivoire. Formez-vous aux métiers de demain : technicien de raccordement, monteur de lignes, superviseur FTTH.';
const pageImage = 'https://kmc.ci/og-image.jpg';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'KMC — Knowledge Management Center',
    description: pageDescription,
    url: 'https://kmc.ci',
    logo: 'https://kmc.ci/logo.png',
    sameAs: [
      'https://www.linkedin.com/company/kmc-ci',
      'https://www.facebook.com/kmc.ci'
    ],
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'CI',
      addressLocality: 'Abidjan'
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Formation',
      availableLanguage: ['French']
    }
  }}
>
  <!-- Script inline dans le <head> : désactive la restauration de scroll AVANT que le
       navigateur puisse la déclencher. Les scripts de type module (bundlés) s'exécutent
       trop tard pour cela. -->
  <script is:inline slot="head">
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  </script>

  <Navigation />
  <main id="main-content">
    <ScrollytellingHero />

    <!-- Section Cours Gratuits -->
    <section class="bg-[#070a10] py-24 md:py-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">

        <!-- Header -->
        <div class="text-center mb-16">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1e9ad7]/10 border border-[#1e9ad7]/20 text-[#1e9ad7] text-sm font-semibold tracking-wide uppercase mb-4">
            Ressources pédagogiques
          </span>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">
            Cours <span class="text-[#F59E0B]">gratuits</span> en fibre optique
          </h2>
          <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
            Explorez nos ressources pédagogiques en accès libre — conçues par les formateurs KMC pour comprendre les fondamentaux des réseaux fibre optique.
          </p>
        </div>

        <!-- Contenu : image + cartes -->
        <div class="grid lg:grid-cols-2 gap-10 items-center mb-12">

          <!-- Image illustrative -->
          <div class="relative rounded-2xl overflow-hidden shadow-[0_0_60px_rgba(30,154,215,0.15)]">
            <img
              src="/images/cours/quest-ce-que-la-fibre-optique-hero.jpg"
              alt="Cours gratuits en fibre optique — ressources pédagogiques KMC"
              width="1024"
              height="576"
              loading="lazy"
              class="w-full h-64 md:h-80 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#070a10]/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="inline-flex items-center gap-2 bg-[#1e9ad7]/20 backdrop-blur-sm border border-[#1e9ad7]/30 text-[#7dd3fc] text-sm font-medium px-3 py-1.5 rounded-full">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                9 cours disponibles · Accès libre
              </span>
            </div>
          </div>

          <!-- Cartes preview -->
          <div class="space-y-4">
            {[
              { titre: "Qu'est-ce que la fibre optique ?", duree: "35 min", niveau: "Débutant", slug: "quest-ce-que-la-fibre-optique" },
              { titre: "Comment se déroule un raccordement fibre ?", duree: "40 min", niveau: "Débutant", slug: "raccordement-fibre" },
              { titre: "Fibre optique vs cuivre — comparatif", duree: "25 min", niveau: "Débutant", slug: "fibre-optique-vs-cuivre" },
            ].map((cours) => (
              <a
                href={`/cours/${cours.slug}/`}
                class="flex items-center gap-4 p-4 rounded-xl border border-white/[0.08] bg-white/[0.03] hover:bg-white/[0.06] hover:border-[#1e9ad7]/30 transition-all duration-300 group"
              >
                <div class="w-10 h-10 rounded-lg bg-[#1e9ad7]/10 flex items-center justify-center shrink-0 group-hover:bg-[#1e9ad7]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#1e9ad7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-white font-medium text-sm leading-snug group-hover:text-[#7dd3fc] transition-colors truncate">{cours.titre}</p>
                  <p class="text-white/40 text-xs mt-0.5">{cours.niveau} · {cours.duree}</p>
                </div>
                <svg class="w-4 h-4 text-white/30 group-hover:text-[#1e9ad7] shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center">
          <a
            href="/cours/"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full border border-[#1e9ad7]/40 text-[#7dd3fc] font-semibold hover:bg-[#1e9ad7]/10 hover:border-[#1e9ad7]/60 transition-all duration-300"
          >
            Voir tous les cours gratuits
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  import { initLenis } from '../lib/scroll';

  // Forcer scroll à 0 après initialisation (double sécurité)
  window.scrollTo(0, 0);

  // initLenis() is idempotent — returns existing instance if ScrollytellingHero already called it
  const lenis = initLenis();

  // Handle /#operators and #operators anchor clicks:
  // The scrollytelling section is pinned, so a standard anchor won't land correctly.
  // We target ≈52% through #scrolly (where the operator scene is visible).
  document.querySelectorAll<HTMLAnchorElement>('a[href="/#operators"], a[href="#operators"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const scrolly = document.getElementById('scrolly');
      if (!scrolly) return; // not on homepage / no scrolly section
      e.preventDefault();
      const target = scrolly.offsetTop + scrolly.offsetHeight * 0.52;
      if (lenis && typeof lenis.scrollTo === 'function') {
        lenis.scrollTo(target, { offset: 0 });
      } else {
        window.scrollTo({ top: target, behavior: 'smooth' });
      }
    });
  });
</script>

---
import { getFormationByName } from '../lib/notion';
import { operators } from '../data/operators';
import OperatorWindow from './OperatorWindow.astro';
import FormationCard from './FormationCard.astro';
const formation = await getFormationByName('FTTH-D2');
---
<section id="scrolly" aria-label="Présentation KMC" style="height:950vh;">
  <div id="scrolly-stage" class="sticky top-0 h-screen w-full overflow-hidden bg-[#070d18]" style="perspective:1200px;">

    <!-- Couche IMG2 + vidéo (z-10) : scènes 5,6,9 -->
    <div id="layer-img2" class="absolute inset-0 z-10 opacity-0 will-change-transform">
      <img src="/images/Image 2 - reseau.png" alt="Réseau fibre optique" class="w-full h-full object-contain" />
      <video id="flux-video" class="absolute inset-0 w-full h-full object-contain opacity-0"
             autoplay loop muted playsinline preload="auto">
        <source src="/images/video flux fibre.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Couche IMG1 (z-20) : scènes 3,4 -->
    <div id="layer-img1" class="absolute inset-0 z-20 opacity-0">
      <img src="/images/Image 1 - centre de formation.png" alt="Centre de formation KMC" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#070d18]/85 via-[#070d18]/30 to-transparent"></div>
    </div>

    <!-- Couche IMG0 éléphant + techniciens + titre serif (z-30) : scène 1 -->
    <div id="layer-img0" class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-10 bg-[#070d18] px-6">
      <h1 class="font-serif text-3xl md:text-5xl font-bold text-white text-center max-w-4xl lg:absolute lg:top-[10%] lg:left-1/2 lg:-translate-x-1/2 lg:w-full lg:px-6">
        <span class="text-[#1e9ad7]">K</span><span class="text-[#1e9ad7]">M</span><span class="text-[#F59E0B]">C</span> — Institut de formation professionnel en <span class="text-[#F59E0B]">fibre optique</span>
      </h1>
      <!-- Éléphant : centré au départ, glisse à gauche (desktop) — empilé en mobile.
           Wrapper de positionnement séparé de .relief-panel (sinon position:relative écrase lg:absolute). -->
      <div id="elephant" class="max-w-[80%] lg:max-w-none lg:absolute lg:left-1/2 lg:top-1/2">
        <div class="relief-panel relief-2 fiber-pulse p-3" style="background:linear-gradient(rgba(28,70,116,.85),rgba(20,52,90,.88)) padding-box,linear-gradient(100deg,#f59e0b,#1e9ad7) border-box;">
          <img src="/images/Image 0 - Elephant.png" alt="Éléphant, emblème de KMC — Institut de formation en fibre optique" class="relative z-10 max-h-[46vh] w-auto object-contain" />
        </div>
      </div>
      <!-- Techniciens : entrent par la droite en miroir de l'éléphant (desktop) — empilés sous l'éléphant en mobile -->
      <div id="technicians" class="max-w-[80%] lg:max-w-[38vw] lg:absolute lg:left-1/2 lg:top-1/2 lg:opacity-0">
        <div class="relief-panel relief-2 fiber-pulse p-3">
          <img src="/images/deux-techniciens-ivoiriens-fibre.png" alt="Deux techniciens ivoiriens en intervention sur la fibre optique" class="relative z-10 max-h-[40vh] w-auto object-contain object-center" />
        </div>
      </div>
    </div>

    <!-- Carte texte + logos (z-40) : scène 4 -->
    <div id="layer-text" class="absolute inset-0 z-40 flex items-center justify-center pt-24 pb-8 px-4 opacity-0">
      <div class="max-w-3xl w-full rounded-2xl border border-white/10 px-8 py-7 text-center"
           style="backdrop-filter: blur(14px); background: rgba(10,22,40,0.68);">

        <!-- Logo KMC -->
        <div class="flex justify-center mb-5">
          <div class="bg-white/95 rounded-xl px-5 py-2">
            <img
              src="/images/logo-kmc.png"
              alt="KMC — Knowledge Management Center"
              class="h-10 w-auto object-contain"
            />
          </div>
        </div>

        <!-- H1 — grand titre -->
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">
          Institut Professionnel<br/>
          de Formation en&nbsp;<span class="text-[#1e9ad7]">Fibre Optique</span>
        </h2>

        <!-- H2 -->
        <h2 class="text-base md:text-xl text-white/80 font-light max-w-2xl mx-auto mb-4 leading-relaxed">
          Devenez technicien <span class="text-[#F59E0B] font-medium">reconnu par l'état Ivoirien</span>
          en fibre optique à Abidjan avec notre institut de formation certifié.
        </h2>

        <!-- Texte enrichi -->
        <p class="text-white/60 text-sm md:text-base max-w-xl mx-auto mb-6 leading-relaxed">
          KMC forme des professionnels aux métiers d'avenir : raccordement&nbsp;FTTH,
          supervision&nbsp;NRO, installation photovoltaïque.
          Nos programmes sont <span class="text-[#1e9ad7] font-medium">éligibles au financement&nbsp;FDFP</span>
          et reconnus par l'Agence Emploi Jeunes.
        </p>

        <!-- Séparateur + logos -->
        <div class="flex items-center justify-center gap-4 mb-5">
          <div class="h-px w-16 bg-[#1e9ad7]/30"></div>
          <span class="text-white/35 text-xs tracking-widest uppercase">Partenaires officiels</span>
          <div class="h-px w-16 bg-[#1e9ad7]/30"></div>
        </div>

        <div class="flex items-center justify-center gap-8 flex-wrap mb-6">
          <a
            href="https://fdfp.ci/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="FDFP — Fonds de Développement de la Formation Professionnelle"
            class="block bg-white/95 hover:bg-white rounded-xl px-4 py-2.5 transition-all duration-300 hover:scale-105 hover:shadow-[0_0_20px_rgba(30,154,215,0.4)]"
          >
            <img src="/images/FDFP.png" alt="FDFP" class="h-12 w-auto object-contain" loading="lazy" />
          </a>
          <a
            href="https://agenceemploijeunes.ci/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Agence Emploi Jeunes — Guichet Unique de l'Emploi en Côte d'Ivoire"
            class="block bg-white/95 hover:bg-white rounded-xl px-4 py-2.5 transition-all duration-300 hover:scale-105 hover:shadow-[0_0_20px_rgba(30,154,215,0.4)]"
          >
            <img src="/images/AEJ.png" alt="Agence Emploi Jeunes" class="h-12 w-auto object-contain" loading="lazy" />
          </a>
        </div>

        <!-- Label habilitation — en bas, gros, gras -->
        <div class="border-t border-white/10 pt-4">
          <p class="text-white font-bold text-base md:text-lg tracking-wide">
            Habilité par l'État Ivoirien &nbsp;·&nbsp; Abidjan, Côte d'Ivoire
          </p>
        </div>

        <a href="/contact/" class="btn-cta-gradient mt-5 inline-flex px-5 py-2.5 rounded-lg font-bold text-[#06121f]">Demander un devis</a>

      </div>
    </div>

    <!-- Texte intro opérateurs (z-50) : scène 7 -->
    <div id="layer-op-intro" class="absolute inset-0 z-50 flex items-center justify-center px-4 opacity-0 bg-[#070d18]/60">
      <div class="max-w-3xl text-center">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-6">KMC forme les techniciens des<br/><span class="text-[#1e9ad7]">3 opérateurs nationaux</span></h2>
        <p class="text-white/70 text-lg leading-relaxed">KMC est le premier centre de formation en Côte d'Ivoire à former des techniciens fibre optique pour Orange CI, MTN Côte d'Ivoire et Moov Africa. Nos programmes couvrent à la fois la maîtrise technique du raccordement FTTH et la manipulation du matériel spécifique à chaque opérateur — pour une insertion professionnelle immédiate sur le terrain.</p>
      </div>
    </div>

    <!-- 3 fenêtres opérateurs (z-50) : scène 8 -->
    <div id="layer-ops" class="absolute inset-0 z-50 flex items-center justify-center px-4 opacity-0">
      <div id="operators" class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl w-full" style="perspective:1000px;">
        {operators.map((op, i) => (
          <div class={`op-win op-win-${i}`} style="transform-style:preserve-3d;"><OperatorWindow op={op} /></div>
        ))}
      </div>
    </div>

    <!-- Texte présentation centre de formation (z-55) : affiché APRÈS le dézoom NRO -->
    <div id="layer-presentation" class="absolute inset-0 z-[55] flex items-center justify-center px-4 opacity-0 bg-[#070d18]/70">
      <div class="max-w-3xl text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-5">Centre de formation de techniciens <span class="text-[#1e9ad7]">fibre optique</span> à Abidjan</h2>
        <p class="text-white/70 text-base md:text-lg leading-relaxed mb-4">KMC forme des techniciens immédiatement opérationnels sur les réseaux FTTH des trois grands opérateurs ivoiriens (Orange, MTN, Moov), en associant enseignement théorique et ateliers pratiques intensifs sur matériel professionnel.</p>
        <p class="text-white/60 text-sm md:text-base leading-relaxed mb-7">Sécurité chantier, habilitations de base, raccordement, soudure et mesures OTDR : nos apprenants sont évalués tout au long du parcours puis mis en situation en entreprise. Exemple de parcours : la formation <span class="text-[#F59E0B] font-semibold">FTTH-D2</span>.</p>
        <a href="/contact/" class="btn-cta-gradient inline-flex px-6 py-3 rounded-lg font-bold text-[#06121f]">Demander un devis ou des informations</a>
      </div>
    </div>

    <!-- Fiche formation (z-60) : scène 10 -->
    <div id="layer-formation" class="absolute inset-0 z-60 flex flex-col items-center justify-center pt-24 pb-8 px-4 opacity-0">
      <FormationCard formation={formation} />
      <a href="/formations-fibre-optique/" class="btn-cta-gradient mt-7 inline-flex px-6 py-3 rounded-lg font-bold text-[#06121f]">Voir le catalogue complet</a>
    </div>

  </div>
</section>

<script>
  import { gsap, ScrollTrigger, initLenis } from '../lib/scroll';
  initLenis();

  const mm = gsap.matchMedia();

  // Desktop avec motion autorisé → scrollytelling complet
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const img0 = document.getElementById('layer-img0');
    const elephant = document.getElementById('elephant');
    const technicians = document.getElementById('technicians');
    const img1 = document.getElementById('layer-img1');
    const img2 = document.getElementById('layer-img2');
    const video = document.getElementById('flux-video');
    const text = document.getElementById('layer-text');
    const opIntro = document.getElementById('layer-op-intro');
    const ops = document.getElementById('layer-ops');
    const presentation = document.getElementById('layer-presentation');
    const formation = document.getElementById('layer-formation');
    const opWins = gsap.utils.toArray<HTMLElement>('.op-win');

    // État initial scène 1 (desktop) : éléphant centré ; techniciens centrés mais cachés, décalés à droite
    gsap.set(elephant, { xPercent: -50, yPercent: -50, x: 0 });
    gsap.set(technicians, { xPercent: -50, yPercent: -50, opacity: 0, x: 360 });

    const tl = gsap.timeline();
    // Scène 1 : l'éléphant glisse à gauche, les techniciens entrent par la droite — fin = miroir (±240px)
    tl.to(elephant, { x: -240, duration: 0.3, ease: 'sine.inOut' }, 0)
      .to(technicians, { opacity: 1, x: 240, duration: 0.3, ease: 'power2.out' }, 0.05)
      // Scène 1 → 3 : Image 1 révélée par le glissement vers le haut de la couche éléphant/techniciens
      .set(img1, { opacity: 1 }, 0.35)
      .to(img0, { yPercent: -100, duration: 0.6, ease: 'power2.in' }, 0.4)
      // Scène 4 : Image 1 tient un peu plus longtemps avant le texte
      .to(text, { opacity: 1, duration: 0.4 }, 1.2)
      // Scène 5 : Image 1 + carte texte glissent vers le haut → Image 2 réseau révélée
      .set(img2, { opacity: 1 }, 2.5)
      .to([img1, text], { yPercent: -100, duration: 0.6, ease: 'power2.in' }, 2.6)
      .to(video, { opacity: 1, duration: 0.4 }, 2.9)
      // Scène 6 : zoom sur les 3 opérateurs (bord gauche) — origine fixée ici
      .to(img2, { scale: 1.65, transformOrigin: '6% 45%', duration: 1 }, 3.4)
      // Scène 7 : intro opérateurs
      .to(opIntro, { opacity: 1, duration: 0.5 }, 4.6)
      .to(opIntro, { opacity: 0, duration: 0.4 }, 5.4)
      // Scène 8 : fenêtres opérateurs en cascade
      .to(ops, { opacity: 1, duration: 0.2 }, 5.5)
      .from(opWins, { opacity: 0, y: 40, stagger: 0.4, duration: 0.5 }, 5.6)
      .to(ops, { opacity: 0, duration: 0.4 }, 7.1)
      // Scène 9 : dézoom depuis les opérateurs vers le NRO — MÊME origine (6% 45%) → pas de saut
      .to(img2, { scale: 1.25, duration: 0.9 }, 7.3)
      // Scène 9b : texte de présentation APRÈS la fin du dézoom (8.2) — laisse voir le NRO d'abord
      .to(presentation, { opacity: 1, duration: 0.4 }, 8.3)
      .to(presentation, { opacity: 0, duration: 0.3 }, 9.0)
      // Scène 10 : fiche formation (décalée après la présentation)
      .to(formation, { opacity: 1, duration: 0.6 }, 9.2)
      .to({}, { duration: 1.0 }, 10.0);

    const st = ScrollTrigger.create({
      trigger: '#scrolly', start: 'top top', end: 'bottom bottom',
      scrub: 1.2, pin: '#scrolly-stage', invalidateOnRefresh: true, animation: tl,
    });

    // Cleanup : matchMedia revert quand on quitte ce contexte
    return () => { st.kill(); tl.kill(); };
  });

  // Mobile OU reduced-motion → layout empilé aplati
  mm.add('(max-width: 1023px), (prefers-reduced-motion: reduce)', () => {
    const stage = document.getElementById('scrolly-stage');
    const scrolly = document.getElementById('scrolly');
    const layers = document.querySelectorAll<HTMLElement>('#scrolly-stage > div');
    layers.forEach((el) => { el.style.opacity = '1'; el.style.position = 'relative'; });
    if (stage) { stage.style.position = 'static'; stage.style.height = 'auto'; }
    if (scrolly) scrolly.style.height = 'auto';
    const v = document.getElementById('flux-video') as HTMLVideoElement | null;
    if (v) v.style.opacity = '1';

    // Cleanup : on remet les styles inline à zéro pour repasser en desktop
    return () => {
      layers.forEach((el) => { el.style.opacity = ''; el.style.position = ''; });
      if (stage) { stage.style.position = ''; stage.style.height = ''; }
      if (scrolly) scrolly.style.height = '';
      if (v) v.style.opacity = '';
    };
  });
</script>
